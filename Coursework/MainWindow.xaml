<Window x:Class="TaskPlanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Планировщик задач" Height="550" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Добавить задачу" Width="120" Margin="0,0,10,0" Click="BtnAdd_Click"/>
            <Button Content="Удалить задачу" Width="120" Margin="0,0,10,0" Click="BtnDelete_Click"/>
            <Button Content="Изменить статус" Width="120" Margin="0,0,10,0" Click="BtnStatus_Click"/>

            <TextBlock Text="Фильтр:" VerticalAlignment="Center" Margin="10,0"/>
            <ComboBox Name="CbFilter" Width="150" SelectionChanged="CbFilter_SelectionChanged">
                <ComboBoxItem Content="Все"/>
                <ComboBoxItem Content="Запланировано"/>
                <ComboBoxItem Content="В процессе"/>
                <ComboBoxItem Content="Выполнено"/>
            </ComboBox>

            <TextBlock Text="Сортировка:" VerticalAlignment="Center" Margin="10,0"/>
            <ComboBox Name="CbSort" Width="150" SelectionChanged="CbSort_SelectionChanged">
                <ComboBoxItem Content="По дате"/>
                <ComboBoxItem Content="По приоритету"/>
            </ComboBox>
        </StackPanel>

        <ListView Name="LvTasks" Grid.Row="1" BorderBrush="Gray" BorderThickness="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Статус" DisplayMemberBinding="{Binding Status}" Width="100"/>
                    <GridViewColumn Header="Заголовок" DisplayMemberBinding="{Binding Title}" Width="200"/>
                    <GridViewColumn Header="Описание" DisplayMemberBinding="{Binding Description}" Width="250"/>
                    <GridViewColumn Header="Срок" DisplayMemberBinding="{Binding DueDate, StringFormat={}{0:dd.MM.yyyy}}" Width="100"/>
                    <GridViewColumn Header="Приоритет" DisplayMemberBinding="{Binding Priority}" Width="100"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Name="TxtStatusInfo" Text="Всего задач: 0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>