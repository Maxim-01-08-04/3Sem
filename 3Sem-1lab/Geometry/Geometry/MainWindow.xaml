<Window x:Class="Geometry.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Geometry"
        mc:Ignorable="d"
        Title="геометрия" Height="700" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Orientation="Vertical">
            <Slider x:Name="x" Margin="0, 5, 0, 0" Minimum="-10" Maximum="10" ValueChanged="x_ValueChanged" Value=" 0"/>

            <Slider x:Name="y"  Margin="0, 15, 0, 0" Minimum="-10" Maximum="10" ValueChanged="y_ValueChanged" Value="0"/>
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10" Background="LightGray">
                <Button x:Name="btnCreateRandom" Content="Создать случайные фигуры" Click="btnCreateRandom_Click" Margin="5" Padding="10"/>
                <Button x:Name="btnCreateCustom" Content="Создать фигуры по параметрам" Click="btnCreateCustom_Click" Margin="5" Padding="10"/>
                <Button x:Name="btnMove" Content="Переместить фигуры" Click="btnMove_Click" Margin="5" Padding="10"/>
                <Button x:Name="btnClear" Content="Очистить сцену" Click="btnClear_Click" Margin="5" Padding="10"/>
            </StackPanel>
            <Canvas x:Name="Scene" Grid.Row="1" VerticalAlignment="Bottom" 
                Background="White" Margin="15,0,15,15" Height="336"/>
        </StackPanel>


    </Grid>
</Window>
