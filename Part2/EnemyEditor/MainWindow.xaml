<Window x:Class="EnemyEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editor_v0.1" Height="1000" Width="1000" ResizeMode="NoResize">
    <Grid>
        <TabControl>
            <TabItem Header="Редактор противников">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="10">
                        <TextBlock Text="Иконки противников" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                        <Button x:Name="LoadIconsButton" Content="Загрузить иконки из папки" 
                                Click="LoadIconsButton_Click" Height="30" Margin="0,0,0,10"/>

                        <TextBlock Text="Список иконок:" FontWeight="Bold"/>
                        <ListBox x:Name="IconsListBox" Height="200" Margin="0,5,0,10"
                                SelectionChanged="IconsListBox_SelectionChanged"/>

                        <TextBlock Text="Выбранная иконка:" FontWeight="Bold"/>
                        <Image x:Name="MainEnemyIcon" Height="100" Margin="0,5,0,10" Stretch="Uniform"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10">
                        <TextBlock Text="Редактор противников" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Название:" Margin="0,5"/>
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameTextBox" Margin="5"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Базовое здоровье:" Margin="0,5"/>
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="HealthTextBox" Margin="5" Text="100"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Модификатор здоровья:" Margin="0,5"/>
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="HealthModTextBox" Margin="5" Text="1.0"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Базовое золото:" Margin="0,5"/>
                            <TextBox Grid.Row="3" Grid.Column="1" x:Name="GoldTextBox" Margin="5" Text="10"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Модификатор золота:" Margin="0,5"/>
                            <TextBox Grid.Row="4" Grid.Column="1" x:Name="GoldModTextBox" Margin="5" Text="1.0"/>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Шанс появления:" Margin="0,5"/>
                            <TextBox Grid.Row="5" Grid.Column="1" x:Name="SpawnChanceTextBox" Margin="5" Text="0.5"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Имя иконки:" Margin="0,5"/>
                            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="IconNameTextBlock" Margin="5"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,10">
                            <Button x:Name="AddEnemyButton" Content="Добавить противника" 
                                    Click="AddEnemyButton_Click" Margin="0,0,10,0" Width="120"/>
                            <Button x:Name="SaveButton" Content="Сохранить список" 
                                    Click="SaveButton_Click" Margin="0,0,10,0" Width="100"/>
                            <Button x:Name="LoadButton" Content="Загрузить список" 
                                    Click="LoadButton_Click" Width="100"/>
                        </StackPanel>

                        <TextBlock Text="Список противников:" FontWeight="Bold"/>
                        <ListBox x:Name="EnemiesListBox" Height="150" Margin="0,5,0,10"
                                SelectionChanged="EnemiesListBox_SelectionChanged"/>

                        <Button x:Name="DeleteEnemyButton" Content="Удалить выбранного противника" 
                                Click="DeleteEnemyButton_Click" Width="180"/>
                    </StackPanel>
                </Grid>
            </TabItem>


            <TabItem Header="Кликер">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="LightBlue" Margin="10">
                        <StackPanel Orientation="Horizontal" Margin="10">
                            <TextBlock Text="Уровень: " FontWeight="Bold" FontSize="12"/>
                            <TextBlock x:Name="PlayerLevelText" Text="1" Margin="5,0,20,0" FontSize="12"/>

                            <TextBlock Text="Золото: " FontWeight="Bold" FontSize="12"/>
                            <TextBlock x:Name="PlayerGoldText" Text="0" Margin="5,0,20,0" FontSize="12"/>

                            <TextBlock Text="Урон: " FontWeight="Bold" FontSize="12"/>
                            <TextBlock x:Name="PlayerDamageText" Text="1" Margin="5,0,20,0" FontSize="12"/>

                            <TextBlock Text="Следующее улучшение: " FontWeight="Bold" FontSize="12"/>
                            <TextBlock x:Name="UpgradeCostText" Text="10" Margin="5,0,20,0" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1">
                        <Border BorderBrush="Gray" BorderThickness="2" Background="White" Margin="20" x:Name="EnemyArea">
                            <Grid>
                                <Canvas x:Name="GameCanvas">
                                </Canvas>

                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock x:Name="EnemyNameText" Text="Противник" FontSize="20" FontWeight="Bold" 
                                  HorizontalAlignment="Center" Margin="0,0,0,15" Foreground="DarkRed"/>

                                    <Border BorderBrush="Black" BorderThickness="1" Background="LightYellow" Margin="0,0,0,15">
                                        <Image x:Name="EnemyImage" Width="150" Height="150" Stretch="Uniform"
                                  HorizontalAlignment="Center" Margin="5"/>
                                    </Border>

                                    <TextBlock Text="Здоровье:" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                    <ProgressBar x:Name="EnemyHealthBar" Width="300" Height="25" 
                                    Minimum="0" Maximum="100" Value="100" Margin="0,0,0,10"/>

                                    <TextBlock x:Name="EnemyHealthText" Text="100/100" HorizontalAlignment="Center" 
                                  FontWeight="Bold" Margin="0,0,0,20" FontSize="12"/>

                                    <TextBlock Text="Перезарядка атаки:" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,5"/>
                                    <ProgressBar x:Name="CooldownProgressBar" Width="300" Height="15" 
                                     Minimum="0" Maximum="100" Value="100" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="CooldownText" Text="Готово!" HorizontalAlignment="Center" 
                                   FontSize="10" Margin="0,0,0,15"/>

                                    <Button x:Name="AttackButton" Content="Атаковать!" Width="120" Height="40" 
                                Click="AttackButton_Click" FontSize="14" FontWeight="Bold" 
                                Background="Red" Foreground="White" BorderThickness="0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" Background="LightYellow" Margin="10" Padding="5">
                        <StackPanel>
                            <TextBlock Text="Активные бонусы:" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <StackPanel x:Name="ActiveEffectsPanel" Orientation="Horizontal" 
                           HorizontalAlignment="Center" Margin="5">
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Background="LightGreen" Margin="10">
                        <StackPanel Orientation="Horizontal" Margin="10" HorizontalAlignment="Center">
                            <Button x:Name="UpgradeButton" Content="Улучшить урон" Width="120" Height="35" 
                        Click="UpgradeButton_Click" Margin="0,0,10,0" FontWeight="Bold"/>

                            <TextBlock x:Name="UpgradeInfoText" Text="Стоимость: 10 золота" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="4" Background="LightBlue" Margin="10" Padding="5">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="UpgradeCooldownButton" Content="Улучшить перезарядку (100 золота)" 
                        Click="UpgradeCooldownButton_Click" Width="200" Margin="0,0,10,0"/>
                            <TextBlock Text="Уменьшает перезарядку атаки на 10%" VerticalAlignment="Center" FontSize="10"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="10" HorizontalAlignment="Center">
                        <Button x:Name="LoadGameButton" Content="Загрузить противников в игру" 
                    Click="LoadGameButton_Click" Width="180" Height="30" Margin="0,0,10,0"/>
                        <Button x:Name="ResetGameButton" Content="Сбросить игру" 
                    Click="ResetGameButton_Click" Width="100" Height="30"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>