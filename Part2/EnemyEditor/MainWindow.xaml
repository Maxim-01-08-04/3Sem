<Window x:Class="EnemyEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editor_v0.1" Height="450" Width="800" ResizeMode="NoResize"
        MouseDown="Window_MouseDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Header="Enemy icon:" Margin="0,0,0,10">
            <ScrollViewer Height="150" VerticalScrollBarVisibility="Auto">
                <Canvas x:Name="IconsCanvas" Height="400" Background="White"/>
            </ScrollViewer>
        </GroupBox>

        <!-- Левая панель - список противников -->
        <StackPanel Grid.Column="0" Margin="10">
            <TextBlock Text="List of enemies:" FontWeight="Bold" Margin="0,0,0,10"/>
            <ListBox x:Name="lstEnemies" Height="200" Margin="0,0,0,20"/>

            <!-- Кнопки управления -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Save" Click="btnSave_Click" Margin="5" Padding="10,5"/>
                <Button Content="Load" Click="btnLoad_Click" Margin="5" Padding="10,5"/>
                <Button Content="Add" Click="btnAddEnemy_Click" Margin="5" Padding="10,5"/>
                <Button Content="Remove" Click="btnRemove_Click" Margin="5" Padding="10,5"/>
            </StackPanel>

            <!-- Кнопка загрузки иконок -->
            <Button Content="Load Icons" Click="btnLoadIcons_Click" Margin="0,10,0,0" Padding="10,5"/>
        </StackPanel>

        <!-- Правая панель - редактирование и иконки -->
        <StackPanel Grid.Column="1" Margin="10">
            <GroupBox Header="Enemy icon:" Margin="0,0,0,10">
                <Canvas x:Name="IconsCanvasMain" Height="100" Background="White"/>
            </GroupBox>

            <StackPanel>
                <TextBlock Text="Icon name:"/>
                <TextBox x:Name="txtIconName" IsReadOnly="True" Background="LightGray" Margin="0,0,0,10"/>

                <TextBlock Text="Enemy Name:"/>
                <TextBox x:Name="txtEnemyName" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Base life:"/>
                        <TextBox x:Name="txtBaseLife"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Base gold:"/>
                        <TextBox x:Name="txtBaseGold"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Life modifier:"/>
                        <TextBox x:Name="txtLifeModifier"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Gold modifier:"/>
                        <TextBox x:Name="txtGoldModifier"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Spawn chance (1-100):"/>
                <TextBox x:Name="txtSpawnChance" Margin="0,0,0,10"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>