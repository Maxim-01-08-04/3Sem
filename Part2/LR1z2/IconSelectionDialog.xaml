<Window x:Class="EnemyEditor.IconSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Icon" Height="400" Width="300" WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox x:Name="IconsListBox" Grid.Row="0" Margin="5"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button Content="Закрыть" Width="80" Margin="5" Click="CancelButton_Click"/>
            <Button Content="Выбрать" Width="80" Margin="5" Click="SelectButton_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>