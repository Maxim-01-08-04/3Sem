<Window x:Class="EnemyEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enemy Editor" Height="500" Width="850" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Column="0" Grid.Row="0" Text="Список врагов" Margin="0,0,0,5" FontWeight="Bold"/>

        <ListBox Grid.Column="0" Grid.Row="1" x:Name="EnemiesListBox" Margin="0,0,5,0" 
                 SelectionChanged="EnemiesListBox_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Column="0" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
            <Button x:Name="SaveButton" Content="Сохранить" Width="60" Margin="2" Click="SaveButton_Click"/>
            <Button x:Name="LoadButton" Content="Загрузить" Width="60" Margin="2" Click="LoadButton_Click"/>
            <Button x:Name="AddButton" Content="Добавить" Width="60" Margin="2" Click="AddButton_Click"/>
            <Button x:Name="RemoveButton" Content="Удалить" Width="60" Margin="2" Click="RemoveButton_Click"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="3" Margin="10,0,10,0">
            <TextBlock Text="Иконка врага" FontWeight="Bold" Margin="0,0,0,5"/>

            <Border BorderBrush="Black" BorderThickness="1" Background="White" Height="120" Margin="0,0,0,10">
                <Image x:Name="EnemyIconImage" Stretch="Uniform" Margin="5"/>
            </Border>

            <TextBlock Text="Имя иконки" Margin="0,0,0,2"/>
            <TextBox x:Name="IconNameTextBox" Margin="0,0,0,10" Height="25" IsReadOnly="True" Background="#FFF0F0F0"/>

            <TextBlock Text="Имя врага" Margin="0,0,0,2"/>
            <TextBox x:Name="EnemyNameTextBox" Margin="0,0,0,10" Height="25" Text="Enemy"/>

            <Button x:Name="LoadIconsButton" Content="Загрузить иконку" Height="30" Click="LoadIconsButton_Click"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="3">
            <TextBlock Text="Тип врага" Margin="0,10,0,2"/>
            <ComboBox x:Name="EnemyTypeComboBox" Margin="0,0,0,10" Height="25" SelectionChanged="EnemyTypeComboBox_SelectionChanged"/>

            <StackPanel x:Name="SpecialPropertyPanel" Visibility="Collapsed">
                <TextBlock x:Name="SpecialPropertyTextBlock" Text="Special Property:" Margin="0,0,0,2"/>
                <TextBox x:Name="SpecialPropertyTextBox" Margin="0,0,0,10" Height="25" Text="0"/>
            </StackPanel>

            <TextBlock Text="Базовое хп" Margin="0,0,0,2"/>
            <TextBox x:Name="BaseLifeTextBox" Margin="0,0,0,10" Height="25" Text="100"/>

            <TextBlock Text="Базовое голд:" Margin="0,0,0,2"/>
            <TextBox x:Name="BaseGoldTextBox" Margin="0,0,0,10" Height="25" Text="50"/>

            <TextBlock Text="Модификатор здоровья" Margin="0,0,0,2"/>
            <TextBox x:Name="LifeModifierTextBox" Margin="0,0,0,10" Height="25" Text="1"/>

            <TextBlock Text="Модификатор голды" Margin="0,0,0,2"/>
            <TextBox x:Name="GoldModifierTextBox" Margin="0,0,0,10" Height="25" Text="1"/>

            <TextBlock Text="Шанс появления (1-100):" Margin="0,0,0,2"/>
            <TextBox x:Name="SpawnChanceTextBox" Margin="0,0,0,20" Height="25" Text="50"/>

            <Button x:Name="ApplyButton" Content="Применить изменения" Height="30" Click="ApplyButton_Click" 
                    Background="#FF007ACC" Foreground="White" FontWeight="Bold"/>

            <Button x:Name="StartGameButton" Content="Начать игру" Width="80" Margin="2" Click="StartGameButton_Click"/>
        </StackPanel>
    </Grid>
</Window>