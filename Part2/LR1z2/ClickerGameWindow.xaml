<Window x:Class="EnemyEditor.ClickerGameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clicker" Height="500" Width="700" WindowStartupLocation="CenterScreen"
        Background="#FFF0F0F0">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель - враг и сферы -->
        <Border Grid.Row="0" Grid.Column="0" Grid.RowSpan="3" 
                BorderBrush="#FFCCCCCC" BorderThickness="1" Background="White"
                Margin="0,0,10,0">

            <Grid>
                <!-- Область для сфер - ЗА врагом -->
                <Canvas x:Name="CollectablesCanvas" 
                        Background="Transparent" 
                        MouseDown="CollectablesCanvas_MouseDown"
                        Panel.ZIndex="1"/>

                <!-- Враг - поверх сфер -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="2">
                    <TextBlock x:Name="EnemyNameText" FontSize="24" FontWeight="Bold" 
                              HorizontalAlignment="Center" Margin="0,0,0,15" Text="Enemy"/>

                    <Border x:Name="EnemyIconBorder" BorderBrush="Black" BorderThickness="3" 
                           Background="LightBlue" Width="160" Height="160" 
                           HorizontalAlignment="Center"
                           Cursor="Hand" MouseDown="EnemyIcon_MouseDown">
                        <Image x:Name="EnemyIconImage" Stretch="Uniform" />
                    </Border>

                    <TextBlock x:Name="AttackHintText" Text="Click to attack!" FontSize="14" 
                              HorizontalAlignment="Center" Margin="0,15,0,10"/>

                    <!-- Индикатор перезарядки -->
                    <StackPanel Orientation="Vertical" Margin="0,0,0,15">
                        <Border Background="LightGray" BorderBrush="Gray" BorderThickness="1" 
                               Height="25" CornerRadius="12" Width="250" HorizontalAlignment="Center">
                            <Border x:Name="CooldownProgress" Background="#FF4CAF50" 
                                   HorizontalAlignment="Left" Width="0" CornerRadius="12"/>
                        </Border>
                        <TextBlock x:Name="CooldownText" Text="Ready!" HorizontalAlignment="Center" 
                                  Margin="0,5,0,0" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Здоровье врага -->
                    <StackPanel>
                        <TextBlock Text="Enemy Health:" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ProgressBar x:Name="HealthBar" Minimum="0" Maximum="100" Value="100" 
                                    Height="25" Margin="0,0,0,5"/>
                        <TextBlock x:Name="HealthText" Text="100/100" HorizontalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Правая панель - статистика и улучшения -->
        <StackPanel Grid.Row="0" Grid.Column="1">
            <TextBlock Text="Player Stats" FontSize="16" FontWeight="Bold" 
                      HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Gold:" FontWeight="Bold" Margin="0,0,0,3"/>
                    <TextBlock x:Name="GoldText" Text="0" FontSize="16" HorizontalAlignment="Center" 
                              Foreground="#FFD4AF37" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Gold from enemy:" FontWeight="Bold" Margin="0,0,0,3"/>
                    <TextBlock x:Name="GoldRewardText" Text="25" FontSize="14" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Правая панель - улучшения -->
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,15,0,0">
            <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Level:" FontWeight="Bold" Margin="0,0,0,3"/>
                    <TextBlock x:Name="LevelText" Text="1" FontSize="16" HorizontalAlignment="Center" 
                              Foreground="#FF2196F3" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Damage:" FontWeight="Bold" Margin="0,0,0,3"/>
                    <TextBlock x:Name="DamageText" Text="8" FontSize="14" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Button x:Name="UpgradeButton" Content="UPGRADE DAMAGE" 
                   Background="#FF4CAF50" Foreground="White" 
                   FontWeight="Bold" FontSize="14" Height="40" 
                   Click="UpgradeButton_Click" Margin="0,0,0,8"
                   BorderThickness="0" Cursor="Hand"/>

            <TextBlock x:Name="UpgradeCostText" Text="Cost: 30" HorizontalAlignment="Center" 
                      FontWeight="Bold" Foreground="#FF795548"/>

            <!-- Новый блок для улучшения перезарядки -->
            <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="12" Margin="0,15,0,10">
                <StackPanel>
                    <TextBlock Text="Cooldown Level:" FontWeight="Bold" Margin="0,0,0,3"/>
                    <TextBlock x:Name="CooldownLevelText" Text="0" FontSize="14" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="CooldownReductionText" Text="Reduction: 0%" FontSize="12" 
                              HorizontalAlignment="Center" Foreground="#FF607D8B"/>
                </StackPanel>
            </Border>

            <Button x:Name="CooldownUpgradeButton" Content="UPGRADE COOLDOWN" 
                   Background="#FF2196F3" Foreground="White" 
                   FontWeight="Bold" FontSize="14" Height="40" 
                   Click="CooldownUpgradeButton_Click" Margin="0,0,0,8"
                   BorderThickness="0" Cursor="Hand"/>

            <TextBlock x:Name="CooldownUpgradeCostText" Text="Cost: 50" HorizontalAlignment="Center" 
                      FontWeight="Bold" Foreground="#FF795548"/>
        </StackPanel>

        <!-- Счетчик повторов -->
        <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Bottom">
            <TextBlock x:Name="RepeatCountText" Text="Repeat Next: 5" FontWeight="Bold" 
                      HorizontalAlignment="Center" FontSize="12" Foreground="#FF607D8B"/>
        </StackPanel>
    </Grid>
</Window>