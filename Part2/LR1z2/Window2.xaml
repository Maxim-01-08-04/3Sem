<Window x:Class="EnemyEditor.Window2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clicker" Height="899" Width="730" WindowStartupLocation="CenterScreen"
        Background="#FFF0F0F0">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="Кликер" 
                   FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <Border Grid.Row="1" Grid.Column="0" 
                BorderBrush="#FFCCCCCC" BorderThickness="1" Background="White"
                Margin="0,0,10,0">

            <Grid>

                <Canvas x:Name="CollectablesCanvas" 
                        Background="Transparent" 
                        MouseDown="CollectablesCanvas_MouseDown"
                        Panel.ZIndex="1"/>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="2">
                    <TextBlock x:Name="EnemyNameText" FontSize="24" FontWeight="Bold" 
                              HorizontalAlignment="Center" Margin="0,0,0,15" Text="Враг"/>

                    <Border x:Name="EnemyIconBorder" BorderBrush="Black" BorderThickness="3" 
                           Background="LightBlue" Width="160" Height="160" 
                           HorizontalAlignment="Center"
                           Cursor="Hand" MouseDown="EnemyIcon_MouseDown">
                        <Image x:Name="EnemyIconImage" Stretch="Uniform" />
                    </Border>

                    <TextBlock x:Name="AttackHintText" Text="Нажми для атаки" FontSize="14" 
                              HorizontalAlignment="Center" Margin="0,15,0,10"/>

                    <StackPanel Orientation="Vertical" Margin="0,0,0,15">
                        <Border Background="LightGray" BorderBrush="Gray" BorderThickness="1" 
                               Height="25" CornerRadius="12" Width="250" HorizontalAlignment="Center">
                            <Border x:Name="CooldownProgress" Background="#FF4CAF50" 
                                   HorizontalAlignment="Left" Width="0" CornerRadius="12"/>
                        </Border>
                        <TextBlock x:Name="CooldownText" Text="Готово" HorizontalAlignment="Center" 
                                  Margin="0,5,0,0" FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Здоровье противника" FontWeight="Bold" Margin="0,0,0,5"/>
                        <ProgressBar x:Name="HealthBar" Minimum="0" Maximum="100" Value="100" 
                                    Height="25" Margin="0,0,0,5"/>
                        <TextBlock x:Name="HealthText" Text="100/100" HorizontalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Grid.Column="1">
            <TextBlock Text="Статистика игрока" FontSize="16" FontWeight="Bold" 
                      HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                <Button x:Name="SaveProgressButton" Content="Сохранить" Width="60" Margin="2" 
               Click="SaveButton_Click" Background="#FF4CAF50" Foreground="White"/>
                <Button x:Name="LoadProgressButton" Content="Загрузить" Width="60" Margin="2" 
               Click="LoadProgressButton_Click" Background="#FF2196F3" Foreground="White"/>
            </StackPanel>

            <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Золото" FontWeight="Bold" Margin="0,0,0,3"/>
                    <TextBlock x:Name="GoldText" Text="0" FontSize="16" HorizontalAlignment="Center" 
                              Foreground="#FFD4AF37" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Золото от врага" FontWeight="Bold" Margin="0,0,0,3"/>
                    <TextBlock x:Name="GoldRewardText" Text="25" FontSize="14" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Уровень" FontWeight="Bold" Margin="0,0,0,3"/>
                    <TextBlock x:Name="LevelText" Text="1" FontSize="16" HorizontalAlignment="Center" 
                              Foreground="#FF2196F3" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Урон" FontWeight="Bold" Margin="0,0,0,3"/>
                    <TextBlock x:Name="DamageText" Text="8" FontSize="14" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Button x:Name="UpgradeButton" Content="УЛУЧШИТЬ УРОН" 
                   Background="#FF4CAF50" Foreground="White" 
                   FontWeight="Bold" FontSize="14" Height="40" 
                   Click="UpgradeButton_Click" Margin="0,0,0,8"
                   BorderThickness="0" Cursor="Hand"/>

            <TextBlock x:Name="UpgradeCostText" Text="Cost: 30" HorizontalAlignment="Center" 
                      FontWeight="Bold" Foreground="#FF795548"/>

            <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="12" Margin="0,15,0,10">
                <StackPanel>
                    <TextBlock Text="Уровень кулдауна" FontWeight="Bold" Margin="0,0,0,3"/>
                    <TextBlock x:Name="CooldownLevelText" Text="0" FontSize="14" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="CooldownReductionText" Text="Снижение 0%" FontSize="12" 
                              HorizontalAlignment="Center" Foreground="#FF607D8B" Cursor=""/>
                </StackPanel>
            </Border>

            <Button x:Name="CooldownUpgradeButton" Content="УЛУЧШИТЬ КУЛДАУН" 
                   Background="#FF2196F3" Foreground="White" 
                   FontWeight="Bold" FontSize="14" Height="40" 
                   Click="CooldownUpgradeButton_Click" Margin="0,0,0,8"
                   BorderThickness="0" Cursor="Hand"/>

            <TextBlock x:Name="CooldownUpgradeCostText" Text="Cost: 50" HorizontalAlignment="Center" 
                      FontWeight="Bold" Foreground="#FF795548"/>
        </StackPanel>

        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                BorderBrush="#FFCCCCCC" BorderThickness="1" Background="White" 
                Margin="0,33,0,0">
            <StackPanel>
                <TextBlock Text="Логи" FontWeight="Bold" Margin="10,5,10,5"/>
                <ListBox x:Name="MessageLog" Height="160" Margin="10,0,10,10"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        Background="#FFF8F8F8"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" 
                    Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
            <TextBlock x:Name="RepeatCountText" Text="Repeat Next: 5" FontWeight="Bold" 
                      FontSize="12" Foreground="#FF607D8B" Margin="0,0,20,0"/>
            <TextBlock x:Name="SaveStatusText" Text="" FontSize="10" 
                      Foreground="#FF757575"/>
        </StackPanel>
    </Grid>
</Window>